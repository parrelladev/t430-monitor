<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.codex.t430fan.control">
    <description>Controlar a ventoinha do ThinkPad T430</description>
    <message>Autentique-se para alterar o nível da ventoinha do ThinkPad</message>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/t430-fan-helper</annotate>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
